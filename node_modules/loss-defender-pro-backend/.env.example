# ========== Loss Defender Pro — Backend ENV ==========
# Copy to .env and replace PLACE YOUR KEY values

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (local Docker Postgres — docs: PostgreSQL)
DATABASE_URL=postgresql://ldp:ldp_secret@localhost:5432/loss_defender_pro?schema=public
# Production example (Neon):
# DATABASE_URL=postgresql://USER:PLACE_YOUR_KEY@HOST/neondb?sslmode=require

# Redis (optional local)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=PLACE_YOUR_KEY_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=PLACE_YOUR_KEY_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Backblaze B2 (S3-compatible) — docs § Storage
B2_KEY_ID=PLACE_YOUR_KEY
B2_APP_KEY=PLACE_YOUR_KEY
B2_BUCKET=PLACE_YOUR_BUCKET_NAME
B2_REGION=us-west-002
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# Optional public URL base
B2_PUBLIC_BASE_URL=

# CORS (prod: set exact origins)
CORS_ORIGIN=true

# App
APP_NAME=Loss Defender Pro
