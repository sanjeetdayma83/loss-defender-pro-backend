# Loss Defender Pro API — copy to .env (never commit .env)
NODE_ENV=development
APP_NAME=Loss Defender Pro API
PORT=3000
API_PREFIX=api
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/loss_defender?schema=public

JWT_ACCESS_SECRET=replace_with_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

UPLOAD_PATH=uploads

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=lossdefenderpro-media
B2_KEY_ID=
B2_APP_KEY=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@lossdefender.in
SMTP_PASS=
MAIL_FROM=Loss Defender Pro <info@lossdefender.in>
MAIL_SUPPORT=support@lossdefender.in
