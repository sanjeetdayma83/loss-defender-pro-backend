// ======================================================
// Loss Defender Pro
// Enterprise Warehouse Intelligence Platform
// Prisma Schema v2 (complete — aligned with application modules)
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  WAREHOUSE_MANAGER
  SUPERVISOR
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Marketplace {
  AMAZON
  FLIPKART
  MEESHO
  SHOPIFY
  WOOCOMMERCE
  MANUAL
}

/// Full order lifecycle used by orders/services/order.service.ts
enum OrderStatus {
  CREATED
  PENDING
  ASSIGNED
  PICKING
  PACKING
  RECORDING
  VERIFYING
  VERIFIED
  READY_TO_SHIP
  SHIPPED
  DISPATCHED
  DELIVERED
  RETURNED
  CLAIMED
  CANCELLED
}

enum PackingStatus {
  PENDING
  STARTED
  COMPLETED
  FAILED
}

enum RecordingStatus {
  CREATED
  STARTED
  PAUSED
  RESUMED
  STOPPED
  UPLOADING
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
}

enum EvidenceStatus {
  CREATED
  GENERATING
  GENERATED
  VERIFIED
  ARCHIVED
  FAILED
}

enum EvidenceType {
  PACKING_VIDEO
  THUMBNAIL
  FRAME_CAPTURE
  AI_REPORT
  PDF_REPORT
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  DELETED
}

enum UploadCategory {
  RECORDING
  THUMBNAIL
  EVIDENCE
  REPORT
  DOCUMENT
  AVATAR
  OTHER
}

enum UploadVisibility {
  PRIVATE
  PUBLIC
}

enum AIProvider {
  OPENAI
  GEMINI
  LOCAL
}

enum AIJobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
  WHATSAPP
  WEBHOOK
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum ClaimStatus {
  DRAFT
  OPEN
  UNDER_REVIEW
  AI_ANALYZING
  WAITING_FOR_EVIDENCE
  APPROVED
  REJECTED
  RESOLVED
  CLOSED
  CANCELLED
}

enum ClaimPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ClaimResolutionType {
  REFUND
  REPLACEMENT
  PARTIAL_REFUND
  DENIED
  NO_ACTION
}

enum ReturnStatus {
  DRAFT
  CREATED
  UNDER_REVIEW
  AI_ANALYZING
  WAITING_FOR_EVIDENCE
  APPROVED
  REJECTED
  REFUNDED
  REPLACED
  CLOSED
  CANCELLED
}

enum ReturnPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReturnResolutionType {
  REFUND
  REPLACEMENT
  PARTIAL_REFUND
  DENIED
  NO_ACTION
}

enum ScanStatus {
  PENDING
  SCANNED
  VERIFIED
  DUPLICATE
  FAILED
  REJECTED
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
}

// ------------------------------------------------------
// Core models
// ------------------------------------------------------

model Company {
  id String @id @default(uuid())

  code  String         @unique @db.VarChar(30)
  name  String         @db.VarChar(150)
  email String?        @unique @db.VarChar(150)
  phone String?        @db.VarChar(20)
  status CompanyStatus @default(ACTIVE)

  users        User[]
  warehouses   Warehouse[]
  orders       Order[]
  recordings   RecordingSession[]
  evidences    Evidence[]
  uploads      Upload[]
  aiJobs       AIJob[]
  notifications Notification[]
  claims       Claim[]
  returns      Return[]
  scans        Scan[]
  reports      Report[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@map("companies")
}

model User {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)
  email     String @unique @db.VarChar(150)

  passwordHash     String
  refreshTokenHash String?

  role   UserRole   @default(OPERATOR)
  status UserStatus @default(PENDING)

  lastLoginAt DateTime?

  ordersCreated Order[]            @relation("OrderCreatedBy")
  recordings    RecordingSession[] @relation("RecordingOperator")
  notifications Notification[]
  claimsAssigned Claim[]           @relation("ClaimAssignedTo")
  claimsResolved Claim[]           @relation("ClaimResolvedBy")
  returnsAssigned Return[]         @relation("ReturnAssignedTo")
  returnsResolved Return[]         @relation("ReturnResolvedBy")
  scansScanned  Scan[]             @relation("ScanScannedBy")
  scansVerified Scan[]             @relation("ScanVerifiedBy")
  reportsGenerated Report[]        @relation("ReportGeneratedBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Warehouse {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String  @db.VarChar(30)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(500)
  address     String? @db.VarChar(500)
  city        String? @db.VarChar(100)
  state       String? @db.VarChar(100)
  country     String? @db.VarChar(100)
  pincode     String? @db.VarChar(20)
  phone       String? @db.VarChar(20)
  email       String? @db.VarChar(150)
  isActive    Boolean @default(true)

  orders      Order[]
  recordings  RecordingSession[]
  evidences   Evidence[]
  uploads     Upload[]
  aiJobs      AIJob[]
  claims      Claim[]
  returns     Return[]
  scans       Scan[]
  reports     Report[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@unique([companyId, code])
  @@index([companyId])
  @@index([name])
  @@map("warehouses")
}

model Order {
  id String @id @default(uuid())

  companyId   String
  warehouseId String
  createdById String

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy User      @relation("OrderCreatedBy", fields: [createdById], references: [id])

  marketplace            Marketplace
  marketplaceOrderId     String? @db.VarChar(100)
  marketplaceShipmentId  String? @db.VarChar(100)

  orderNumber   String  @db.VarChar(100)
  awbNumber     String? @db.VarChar(100)
  customerName  String? @db.VarChar(150)
  customerPhone String? @db.VarChar(30)

  status             OrderStatus        @default(CREATED)
  packingStatus      PackingStatus      @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING)

  expectedItemCount Int @default(0)
  verifiedItemCount Int @default(0)

  recordings RecordingSession[]
  evidences  Evidence[]
  uploads    Upload[]
  aiJobs     AIJob[]
  claims     Claim[]
  returns    Return[]
  scans      Scan[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([createdById])
  @@index([status])
  @@index([packingStatus])
  @@index([marketplace])
  @@index([orderNumber])
  @@index([awbNumber])
  @@map("orders")
}

model RecordingSession {
  id String @id @default(uuid())

  companyId   String
  warehouseId String
  orderId     String
  operatorId  String

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operator  User      @relation("RecordingOperator", fields: [operatorId], references: [id], onDelete: Cascade)

  status RecordingStatus @default(CREATED)

  startedAt DateTime?
  pausedAt  DateTime?
  resumedAt DateTime?
  stoppedAt DateTime?

  durationSeconds Int @default(0)

  localFileName    String?
  originalFileName String?
  fileUrl          String?
  thumbnailUrl     String?
  fileSize         BigInt?

  evidences Evidence[]
  uploads   Upload[]
  aiJobs    AIJob[]
  claims    Claim[]
  returns   Return[]
  scans     Scan[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([orderId])
  @@index([operatorId])
  @@index([status])
  @@map("recording_sessions")
}

model Evidence {
  id String @id @default(uuid())

  companyId   String
  warehouseId String
  orderId     String
  recordingId String

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recording RecordingSession  @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  status EvidenceStatus @default(CREATED)
  type   EvidenceType   @default(PACKING_VIDEO)

  originalVideoUrl  String?
  processedVideoUrl String?
  thumbnailUrl      String?

  hash     String?
  checksum String?

  durationSeconds Int    @default(0)
  fileSize        BigInt?

  metadata Json?

  generatedAt DateTime?
  verifiedAt  DateTime?
  archivedAt  DateTime?

  uploads Upload[]
  aiJobs  AIJob[]
  claims  Claim[]
  returns Return[]
  scans   Scan[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([orderId])
  @@index([recordingId])
  @@index([status])
  @@map("evidence")
}

model Upload {
  id String @id @default(uuid())

  companyId   String
  warehouseId String
  orderId     String?
  recordingId String?
  evidenceId  String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recording RecordingSession?  @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  evidence  Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  originalName String
  fileName     String
  storageKey   String @unique
  bucket       String
  provider     String
  mimeType     String
  extension    String

  category   UploadCategory
  visibility UploadVisibility @default(PRIVATE)
  status     UploadStatus     @default(PENDING)

  size     BigInt  @default(0)
  checksum String?
  hash     String?
  etag     String?
  metadata Json?

  uploadedAt DateTime?
  expiresAt  DateTime?

  aiJobs AIJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([orderId])
  @@index([recordingId])
  @@index([evidenceId])
  @@index([status])
  @@index([category])
  @@index([storageKey])
  @@map("uploads")
}

// ------------------------------------------------------
// AI
// ------------------------------------------------------

model AIJob {
  id String @id @default(uuid())

  companyId   String
  warehouseId String
  orderId     String?
  uploadId    String?
  recordingId String?
  evidenceId  String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  upload    Upload?            @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  recording RecordingSession?  @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  evidence  Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  provider AIProvider
  model    String
  jobType  String
  status   AIJobStatus @default(PENDING)

  prompt String
  input  Json
  output Json?

  confidence     Float  @default(0)
  tokensUsed     Int?
  processingTime Int?
  error          String?

  startedAt   DateTime?
  completedAt DateTime?
  metadata    Json?

  claims  Claim[]
  returns Return[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([status])
  @@index([provider])
  @@map("ai_jobs")
}

// ------------------------------------------------------
// Notifications
// ------------------------------------------------------

model Notification {
  id String @id @default(uuid())

  userId    String?
  companyId String?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  title    String
  body     String
  channel  NotificationChannel
  priority NotificationPriority @default(MEDIUM)
  status   NotificationStatus   @default(PENDING)

  template          String?
  recipient         String
  subject           String?
  provider          String?
  providerMessageId String?

  data     Json?
  metadata Json?

  retryCount Int @default(0)

  scheduledAt   DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  expiresAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@map("notifications")
}

// ------------------------------------------------------
// Claims
// ------------------------------------------------------

model Claim {
  id String @id @default(uuid())

  claimNumber String @unique @db.VarChar(50)

  companyId   String
  warehouseId String
  orderId     String
  recordingId String?
  evidenceId  String?
  aiJobId     String?
  assignedTo  String?
  resolvedBy  String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recording RecordingSession?  @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  evidence  Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  aiJob     AIJob?             @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  assignee  User?              @relation("ClaimAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  resolver  User?              @relation("ClaimResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)

  status         ClaimStatus          @default(DRAFT)
  priority       ClaimPriority        @default(MEDIUM)
  resolutionType ClaimResolutionType?

  title            String
  description      String
  customerRemarks  String?
  internalRemarks  String?
  aiSummary        String?
  aiConfidence     Float   @default(0)
  aiRecommendation String?

  metadata       Json?
  resolutionData Json?

  resolvedAt DateTime?
  closedAt   DateTime?

  returns Return[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@map("claims")
}

// ------------------------------------------------------
// Returns
// ------------------------------------------------------

model Return {
  id String @id @default(uuid())

  returnNumber String @unique @db.VarChar(50)

  companyId   String
  warehouseId String
  orderId     String
  claimId     String?
  recordingId String?
  evidenceId  String?
  aiJobId     String?
  assignedTo  String?
  resolvedBy  String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claim     Claim?             @relation(fields: [claimId], references: [id], onDelete: SetNull)
  recording RecordingSession?  @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  evidence  Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  aiJob     AIJob?             @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  assignee  User?              @relation("ReturnAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  resolver  User?              @relation("ReturnResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)

  status         ReturnStatus          @default(DRAFT)
  priority       ReturnPriority        @default(MEDIUM)
  resolutionType ReturnResolutionType?

  marketplace           String
  marketplaceReturnId   String?

  title           String
  description     String
  customerReason  String?
  internalRemarks String?

  aiSummary        String?
  aiConfidence     Float  @default(0)
  aiRecommendation String?

  refundAmount               Float?
  refundCurrency             String?
  replacementOrderId         String?
  replacementTrackingNumber  String?

  metadata       Json?
  resolutionData Json?

  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@map("returns")
}

// ------------------------------------------------------
// Scanner (barcode scans)
// ------------------------------------------------------

model Scan {
  id String @id @default(uuid())

  companyId   String
  warehouseId String
  orderId     String
  sessionId   String
  evidenceId  String?
  scannedBy   String
  verifiedBy  String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recording RecordingSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidence  Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  scanner   User               @relation("ScanScannedBy", fields: [scannedBy], references: [id])
  verifier  User?              @relation("ScanVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)

  barcode     String
  barcodeType String
  status      ScanStatus @default(PENDING)

  /// Nested device / location / result / stats stored as JSON
  location   Json?
  device     Json?
  result     Json?
  statistics Json?

  remarks String?

  scannedAt  DateTime  @default(now())
  verifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([orderId])
  @@index([sessionId])
  @@index([barcode])
  @@index([status])
  @@map("scans")
}

// ------------------------------------------------------
// Reports
// ------------------------------------------------------

model Report {
  id String @id @default(uuid())

  companyId   String
  warehouseId String?
  generatedBy String

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  generator User       @relation("ReportGeneratedBy", fields: [generatedBy], references: [id])

  reportType  String
  reportName  String
  description String?
  status      ReportStatus @default(PENDING)

  dateRange    Json?
  summary      Json?
  kpi          Json?
  exportFormat String?
  downloadUrl  String?

  isScheduled  Boolean @default(false)
  scheduleCron String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([warehouseId])
  @@index([reportType])
  @@index([status])
  @@map("reports")
}
