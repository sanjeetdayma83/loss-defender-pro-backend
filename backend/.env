NODE_ENV=development
PORT=3000
API_VERSION=v1

# Local dev default (docker-compose postgres). Swap for Neon in prod:
# postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://ldp:ldp@localhost:5432/loss_defender_pro

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-32-chars-min
JWT_REFRESH_SECRET=change-me-different-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=loss-defender-pro-media-dev
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_SIGNED_URL_TTL=900

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@lossdefender.pro

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

FAILED_LOGIN_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15
